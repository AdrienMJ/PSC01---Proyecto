        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[SETUP] Guardar IDs en propiedades globales" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">props.put(&apos;GRUPO_ID&apos;, vars.get(&apos;SETUP_GRUPO_ID&apos;))
props.put(&apos;GASTO_ID&apos;, vars.get(&apos;SETUP_GASTO_ID&apos;))
props.put(&apos;PAGO_ID&apos;,  vars.get(&apos;SETUP_PAGO_ID&apos;))
log.info(&apos;[SETUP] GRUPO_ID=&apos; + vars.get(&apos;SETUP_GRUPO_ID&apos;) + &apos; | GASTO_ID=&apos; + vars.get(&apos;SETUP_GASTO_ID&apos;) + &apos; | PAGO_ID=&apos; + vars.get(&apos;SETUP_PAGO_ID&apos;))</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
